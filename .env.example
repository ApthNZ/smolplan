# smolplan holds no secrets: there is no authentication, no external service,
# and no outbound network access. The only setting is where the database file
# lives, and it is optional.

# Path to the SQLite database. Defaults to smolplan.db beside the code.
# The container image sets this to /data/smolplan.db, on a volume.
SMOLPLAN_DB=/data/smolplan.db
