# smolplan holds no secrets: there is no authentication, no external service,
# and no outbound network access. Every setting below is optional.

# Path to the SQLite database. Defaults to smolplan.db beside the code.
# The container image sets this to /data/smolplan.db, on a volume.
SMOLPLAN_DB=/data/smolplan.db

# Host port published by docker-compose. Defaults to 8107.
SMOLPLAN_PORT=8107

# The address docker-compose publishes that port on. Defaults to 127.0.0.1,
# this machine only. 0.0.0.0 serves it to your network — and then set
# SMOLPLAN_ALLOWED_HOSTS too, or every request by the LAN name is refused.
SMOLPLAN_BIND=127.0.0.1

# The names and addresses the app answers to, comma-separated, ports optional.
# Blank means localhost, 127.0.0.1 and [::1]. Add the hostname or address you
# type into the browser — e.g. localhost,127.0.0.1,planner.example —
# and a reverse proxy's public name if one sits in front. A request naming any
# other host is refused; that is what stops DNS rebinding. `*` turns the check
# off, for when a proxy in front already does it.
SMOLPLAN_ALLOWED_HOSTS=

# The timezone the plan's owner lives in, e.g. Europe/London,
# America/New_York, Pacific/Auckland. "This month" is the server's month, and a
# container with no TZ runs in UTC — last month, east of Greenwich, for the
# first hours of every new one.
TZ=UTC
